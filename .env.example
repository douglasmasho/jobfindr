# Shanda Lite needs NO keys to run — all default sources are free/public.
#
# Optional: Adzuna (free developer tier) improves LOCAL results for the
# countries it covers. Sign up at https://developer.adzuna.com/ .
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Server-only Firebase Admin (same project as shanda). The browser never
# receives these values. Point GOOGLE_APPLICATION_CREDENTIALS at shanda's
# serviceAccount.json, or set FIREBASE_CLIENT_EMAIL + FIREBASE_PRIVATE_KEY.
FIREBASE_PROJECT_ID=shanfa-afbf4
GOOGLE_APPLICATION_CREDENTIALS=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"shanfa-afbf4",...}

